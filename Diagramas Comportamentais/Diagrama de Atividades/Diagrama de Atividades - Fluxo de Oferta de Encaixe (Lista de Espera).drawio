        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam activity {\n    BackgroundColor #FFFFFF\n    BorderColor #2C3E50\n    ArrowColor #2C3E50\n}\nskinparam swimlane {\n    BorderColor #2C3E50\n    TitleBackgroundColor #EAF2F8\n    TitleFontColor #2C3E50\n}\n\n|Agendador|\nstart\nrepeat\n    :Iniciar varredura de horários livres;\n\n    |Sistema|\n    :Buscar pacientes compatíveis na Lista de Espera;\n\n    if (Paciente encontrado?) then (Não)\n        :Encerrar busca;\n        stop\n    else (Sim)\n        :Gerar Oferta de Encaixe (Pendente);\n        \n        fork\n            |Serviço de Notificação|\n            :Disparar aviso de nova oferta;\n        fork again\n            |Sistema|\n            :Registrar log de auditoria da oferta;\n        end fork\n        \n        |Cliente|\n        :Analisar oferta de encaixe;\n        \n        |Sistema|\n        if (Resposta em até 24 horas?) then (Não - UC-054)\n            :Alterar situação da oferta para Expirada;\n        else (Sim)\n            |Cliente|\n            if (Decisão do Cliente?) then (Recusar)\n                |Sistema|\n                :Alterar situação da oferta para Recusada;\n            else (Aceitar)\n                |Sistema|\n                :Realizar double-check do horário;\n                \n                if (Horário continua livre?) then (Sim)\n                    :Alterar situação da oferta para Aceita;\n                    :Gerar Agendamento;\n                    \n                    fork\n                        |Serviço de Notificação|\n                        :Enviar comprovante do agendamento;\n                    fork again\n                        |Sistema|\n                        :Registrar log de auditoria do agendamento;\n                    end fork\n                    stop\n                else (Não)\n                    :Alterar situação da oferta para Expirada;\n                endif\n            endif\n        endif\n    endif\nrepeat while (Voltar para o próximo paciente da lista - RN-068)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Skc9kRe30ySNCdrzSU7N-1">
