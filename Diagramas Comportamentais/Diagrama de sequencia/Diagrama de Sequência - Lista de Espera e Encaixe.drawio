        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide footbox\nskinparam sequence {\n    ArrowColor Black\n    LifeLineBorderColor Gray\n    MessageAlign center\n}\nskinparam participant {\n    BorderColor transparent\n    FontColor White\n    Padding 20\n}\n\nactor \&quot;Usuário\&quot; as User \nparticipant \&quot;WebFrontend\&quot; as Tela #BE2C2E\nparticipant \&quot;AgendaAppService\&quot; as Control #87A446\nparticipant \&quot;ComunicacaoAppService\&quot; as ComService #5B9BD5\nparticipant \&quot;MySQLRepository\&quot; as Repo #E76F26\nparticipant \&quot;NotificationServiceAdapter\&quot; as Notificacao #F4B324\n\nactivate User #0B4A6A\n\nUser -&gt; Tela: solicitarAgendamento(dataHora)\nactivate Tela #BE2C2E\n\nTela -&gt; Control: processarAgendamento(dataHora)\nactivate Control #87A446\n\n&#39; Verificação de disponibilidade direto no BD\nControl -&gt; Repo: contém(dataHora)\nactivate Repo #E76F26\nRepo --&gt; Control: Boolean\ndeactivate Repo\n\nalt Horário Livre (Boolean = true)\n    \n    &#39; Registro do agendamento direto no BD\n    Control -&gt; Repo: confirmar()\n    activate Repo #E76F26\n    Repo --&gt; Control: void\n    deactivate Repo\n    \n    &#39; Delegação da notificação para o serviço de comunicação\n    Control -&gt; ComService: notificar()\n    activate ComService #5B9BD5\n    \n    ComService -&gt; Notificacao: registrarSituaçãoEnvio()\n    activate Notificacao #F4B324\n    Notificacao --&gt; ComService: void\n    deactivate Notificacao\n    \n    ComService --&gt; Control: void\n    deactivate ComService\n    \n    Control --&gt; Tela: sucesso\n    Tela --&gt; User: exibirComprovante()\n    \nelse Horário Ocupado (Boolean = false)\n    Control --&gt; Tela: erro(Indisponível)\n    Tela --&gt; User: exibirErro()\nend\n\ndeactivate Control\ndeactivate Tela\ndeactivate User\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="sJeTXCtXurrPDJeXsKAe-1">
