        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide footbox\nskinparam sequence {\n    ArrowColor Black\n    LifeLineBorderColor Gray\n    MessageAlign center\n}\nskinparam participant {\n    BorderColor transparent\n    FontColor White\n    Padding 20\n}\n\nactor \&quot;Psicólogo\&quot; as User \nparticipant \&quot;WebFrontend\&quot; as Tela #BE2C2E\nparticipant \&quot;AtendimentoAppService\&quot; as Control #87A446\nparticipant \&quot;MySQLRepository\&quot; as Repo #E76F26\nparticipant \&quot;Agendamento\&quot; as Agend #5B9BD5\nparticipant \&quot;Atendimento\&quot; as Atend #5B9BD5\nparticipant \&quot;Evolução Clínica\&quot; as Evolucao #5B9BD5\n\nactivate User #0B4A6A\n\nalt Com agendamento prévio\n    User -&gt; Tela: selecionarAgendamento()\n    activate Tela #BE2C2E\n    Tela -&gt; Control: processarAtendimento(idAgendamento)\n    activate Control #87A446\n    \n    Control -&gt; Repo: buscar()\n    activate Repo #E76F26\n    Repo --&gt; Control: Agendamento\n    deactivate Repo\n    \n    Control -&gt; Agend: registrarRealização()\n    activate Agend #5B9BD5\n    Agend --&gt; Control: void\n    deactivate Agend\n    \n    Control -&gt; Repo: salvar(Agendamento)\n    activate Repo #E76F26\n    Repo --&gt; Control: void\n    deactivate Repo\n    \nelse Sem agendamento (RN-080)\n    User -&gt; Tela: informarDadosAvulsos(paciente, dataHora)\n    Tela -&gt; Control: processarAtendimentoAvulso(dados)\nend\n\nControl -&gt; Atend **: &lt;&lt;create&gt;&gt;\n\nControl -&gt; Atend: registrarRealização(dataHora)\nactivate Atend #5B9BD5\nAtend --&gt; Control: void (Situação = Realizado)\ndeactivate Atend\n\nControl -&gt; Repo: salvar(Atendimento)\nactivate Repo #E76F26\nRepo --&gt; Control: void\ndeactivate Repo\n\nopt Registrar Evolução (UC-033)\n    User -&gt; Tela: escreverEvolução(conteúdo)\n    Tela -&gt; Control: adicionarEvolução(conteúdo)\n    \n    Control -&gt; Evolucao **: &lt;&lt;create&gt;&gt;\n    \n    Control -&gt; Evolucao: registrar(conteúdo)\n    activate Evolucao #5B9BD5\n    Evolucao --&gt; Control: void\n    deactivate Evolucao\n    \n    Control -&gt; Repo: salvar(Evolução Clínica)\n    activate Repo #E76F26\n    Repo --&gt; Control: void\n    deactivate Repo\nend\n\nControl --&gt; Tela: sucesso\ndeactivate Control\nTela --&gt; User: exibirConfirmação()\ndeactivate Tela\n\ndeactivate User\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NxEuZOMDv3GlL61NJ4tk-1">
